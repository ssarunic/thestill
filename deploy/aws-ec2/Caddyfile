# TLS termination for the single-EC2 deployment (spec #66).
# PUBLIC_DOMAIN comes from compose (.env); certificates are provisioned
# automatically via Let's Encrypt and persisted in ./caddy-data.
#
# Only the canonical domain is served. Alias domains (thestill.me ->
# thestill.ai, www, ...) 301 to it via redirects.caddy, which the bootstrap
# generates — always, empty when there are no aliases, because `import` of
# a missing file is a hard parse error.

{$PUBLIC_DOMAIN} {
	# Spec #95 — product usage events. The signed-in app's bundled PostHog
	# SDK sends to /ingest on this origin, so the CSP stays connect-src
	# 'self' and content blockers do not drop events. Cookies and auth
	# headers are stripped (PostHog must never see the session), and so is
	# Referer: the browser sends the page URL with it, query string and
	# all, which would bypass the in-app event filter.
	handle_path /ingest/static/* {
		rewrite * /static{path}
		reverse_proxy https://eu-assets.i.posthog.com:443 {
			header_up -Cookie
			header_up -Authorization
			header_up -Referer
		}
	}
	handle_path /ingest/* {
		reverse_proxy https://eu.i.posthog.com:443 {
			header_up -Cookie
			header_up -Authorization
			header_up -Referer
		}
	}

	handle {
		# SSE progress streams must not be buffered; flush_interval -1 turns
		# proxy buffering off so events reach the browser as they happen.
		reverse_proxy thestill:8000 {
			flush_interval -1
		}
	}

	encode gzip

	log {
		output stdout
		format json
	}
}

import /etc/caddy/redirects.caddy
