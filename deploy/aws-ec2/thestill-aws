def default_vpc(region: str) -> str:
    vpcs = client("ec2", region).describe_vpcs(Filters=[{"Name": "is-default", "Values": ["true"]}])["Vpcs"]
    if not vpcs:
        die(
            f"No default VPC in {region}. Pass --vpc <vpc-id>, or --dalston-sg "
            "so the VPC can be derived from Dalston's security group."
        )
    return vpcs[0]["VpcId"]


def sg_vpc(region: str, sg_id: str) -> str:
    try:
        groups = client("ec2", region).describe_security_groups(GroupIds=[sg_id])["SecurityGroups"]
    except ClientError as exc:
        die(f"Could not read security group {sg_id}: {exc}")
    return groups[0]["VpcId"]


def find_sg(region: str, name: str, vpc_id: str) -> Optional[str]:
    resp = client("ec2", region).describe_security_groups(
        Filters=[{"Name": "group-name", "Values": [name]}, {"Name": "vpc-id", "Values": [vpc_id]}]
    )
    groups = resp.get("SecurityGroups", [])
    return groups[0]["GroupId"] if groups else None


def ensure_app_sg(region: str, vpc_id: str) -> str:
    name = f"{NAME_PREFIX}-app-sg"
    existing = find_sg(region, name, vpc_id)
    if existing:
        log(f"Security group {name} already exists ({existing})")
        sg_id = existing
    else:
        log(f"Creating security group: {name}")
        sg_id = client("ec2", region).create_security_group(
            GroupName=name,
            Description="thestill app: public HTTPS only (spec #66)",
            VpcId=vpc_id,
            TagSpecifications=[{"ResourceType": "security-group", "Tags": base_tags("app")}],
        )["GroupId"]
        audit("sg_created", sg=sg_id, vpc=vpc_id)

    # Caddy terminates TLS on 80/443. Nothing else is exposed — no 22 (SSM
    # Session Manager is the admin path), no 8000, no 5432.
    _authorize(
        region,
        sg_id,
        [
            {
                "IpProtocol": "tcp",
                "FromPort": 80,
                "ToPort": 80,
                "IpRanges": [{"CidrIp": "0.0.0.0/0", "Description": "HTTP (ACME + redirect)"}],
            },
            {
                "IpProtocol": "tcp",
                "FromPort": 443,
                "ToPort": 443,
                "IpRanges": [{"CidrIp": "0.0.0.0/0", "Description": "HTTPS"}],
            },
            {
                "IpProtocol": "udp",
                "FromPort": 443,
                "ToPort": 443,
                "IpRanges": [{"CidrIp": "0.0.0.0/0", "Description": "HTTP/3"}],
            },
        ],
    )
    return sg_id


def _authorize(region: str, sg_id: str, permissions: list[dict]) -> None:
    """Add ingress rules, tolerating ones that already exist.

    The batch call fails atomically if ANY single rule is a duplicate, so
    fall back to per-rule on failure (dalston pattern)."""
    ec2 = client("ec2", region)
    try:
        ec2.authorize_security_group_ingress(GroupId=sg_id, IpPermissions=permissions)
        return
    except ClientError:
        pass
    for perm in permissions:
        try:
            ec2.authorize_security_group_ingress(GroupId=sg_id, IpPermissions=[perm])
        except ClientError as exc:
            if exc.response["Error"]["Code"] != "InvalidPermission.Duplicate":
                raise


def ensure_dalston_rule(region: str, dalston_sg: str, app_sg: str, port: int) -> None:
    """Allow the app SG to reach Dalston on its service port, SG-to-SG.

    Referencing the security group (not an IP) keeps working when Dalston is
    rebuilt with a new private address — the coupling risk called out in
    spec #66's Open Items."""
    log(f"Allowing {app_sg} -> {dalston_sg}:{port}")
    _authorize(
        region,
        dalston_sg,
        [
            {
                "IpProtocol": "tcp",
                "FromPort": port,
                "ToPort": port,
                "UserIdGroupPairs": [{"GroupId": app_sg, "Description": "thestill app"}],
            }
        ],
    )
    audit("dalston_rule_added", dalston_sg=dalston_sg, app_sg=app_sg, port=port)


def pick_public_subnet(region: str, vpc_id: str) -> str:
    """Prefer a subnet that auto-assigns public IPs (i.e. a real public
    subnet); fall back to the first available one."""
    subnets = client("ec2", region).describe_subnets(
        Filters=[{"Name": "vpc-id", "Values": [vpc_id]}, {"Name": "state", "Values": ["available"]}]
    )["Subnets"]
    if not subnets:
        die(f"No available subnets in {vpc_id}")
    public = [s for s in subnets if s.get("MapPublicIpOnLaunch")]
    chosen = sorted(public or subnets, key=lambda s: s["AvailabilityZone"])[0]
    if not public:
        warn(
            f"No subnet in {vpc_id} auto-assigns public IPs; using "
            f"{chosen['SubnetId']} with an explicit public IP. Verify it has "
            "a route to an internet gateway."
        )
    return chosen["SubnetId"]


# ---------------------------------------------------------------------------
# SSM Parameter Store
# ---------------------------------------------------------------------------


def put_secret(region: str, name: str, value: str, *, overwrite: bool = False) -> bool:
    """Write one SecureString. Returns True if written, False if it already
    existed and overwrite was not requested."""
    try:
        client("ssm", region).put_parameter(
            Name=f"{SSM_PREFIX}{name}",
            Value=value,
            Type="SecureString",
            Overwrite=overwrite,
        )
        return True
    except ClientError as exc:
        if exc.response["Error"]["Code"] == "ParameterAlreadyExists":
            return False
        raise


def list_secrets(region: str) -> dict[str, str]:
    """Return {NAME: value} for everything under the prefix."""
    out: dict[str, str] = {}
    paginator = client("ssm", region).get_paginator("get_parameters_by_path")
    for page in paginator.paginate(Path=SSM_PREFIX, Recursive=True, WithDecryption=True):
        for param in page["Parameters"]:
            out[param["Name"].rsplit("/", 1)[-1]] = param["Value"]
    return out


_DOTENV_RE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")
_INLINE_COMMENT_RE = re.compile(r"\s#")


def _parse_env_value(rest: str) -> tuple[str, str]:
    """Return (value, problem). A non-empty problem means: do not use this."""
    rest = rest.strip()
    if not rest:
        return "", ""
    quote = rest[0]
    if quote in ("'", '"'):
        end = rest.find(quote, 1)
        if end == -1:
            return "", f"unterminated {quote} quote"
        trailing = rest[end + 1 :].strip()
        if trailing and not trailing.startswith("#"):
            return "", f"unexpected text after the closing quote ({trailing!r})"
        return rest[1:end], ""
    # Unquoted: an inline comment starts at the first whitespace-preceded '#'.
    # Without this, `KEY=secret  # note` would ship the note as the secret.
    match = _INLINE_COMMENT_RE.search(rest)
    if match:
        rest = rest[: match.start()]
    return rest.strip(), ""


def parse_env_file(path: Path) -> dict[str, str]:
    """Parse a KEY=VALUE file into {NAME: value}.

    Deliberately strict and dumb: no interpolation, no multiline. Anything
    it cannot parse confidently is skipped AND reported — a silently
    mangled credential surfaces days later as an auth failure nobody
    connects back to the deploy (spec #42 FM-1: errors as empty results).
    """
    out: dict[str, str] = {}
    skipped: list[tuple[int, str, str]] = []

    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        match = _DOTENV_RE.match(raw)
        if not match:
            skipped.append((lineno, raw.strip()[:40], "not a KEY=VALUE assignment"))
            continue
        key, rest = match.group(1), match.group(2)
        if key != key.upper():
            skipped.append((lineno, key, "key is not upper-case (env vars are)"))
            continue
        value, problem = _parse_env_value(rest)
        if problem:
            skipped.append((lineno, key, problem))
            continue
        if not value:
            skipped.append((lineno, key, "empty value"))
            continue
        out[key] = value

    for lineno, what, why in skipped:
        warn(f"  {path.name}:{lineno} skipped — {why}: {what}")
    return out


def preflight_secrets(region: str) -> None:
    """Fail before launching a box that could never come up healthy."""
    present = set(list_secrets(region))
    missing = [name for name in REQUIRED_SECRETS if name not in present]
    if not any(name in present for name in LLM_SECRETS):
        missing.append(f"one of {', '.join(LLM_SECRETS)}")
    if missing:
        die(
            "Missing required secrets in SSM:\n  - "
            + "\n  - ".join(missing)
            + f"\n\nAdd them with:\n  thestill-aws secrets put --from-env-file <file>\n"
            f"(they land under {SSM_PREFIX} as SecureString)"
        )
    log(f"Preflight OK — {len(present)} parameters under {SSM_PREFIX}")


