def save_state(state: Deployment) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    STATE_FILE.write_text(json.dumps(asdict(state), indent=2) + "\n")
    STATE_FILE.chmod(0o600)


def load_state() -> Optional[Deployment]:
    if not STATE_FILE.exists():
        return None
    data = json.loads(STATE_FILE.read_text() or "{}")
    # Filter unknown keys so an older state file still loads forward.
    known = {f.name for f in fields(Deployment)}
    return Deployment(**{k: v for k, v in data.items() if k in known})


def require_state() -> Deployment:
    state = load_state()
    if state is None:
        die("No deployment found. Run 'thestill-aws setup --domain <your-domain>' first.")
    return state


