def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="thestill-aws",
        description="Provision and manage thestill's single-EC2 AWS deployment (spec #66).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_setup = sub.add_parser("setup", help="provision shared infra (idempotent, no billable resources)")
    p_setup.add_argument("--domain", required=True, help="FQDN the app will serve, e.g. thestill.example.com")
    p_setup.add_argument("--region", default=DEFAULT_REGION)
    p_setup.add_argument("--dalston-sg", default="", help="Dalston's security group id (derives the VPC)")
    p_setup.add_argument("--dalston-port", type=int, default=8080, help="Dalston service port (default 8080)")
    p_setup.add_argument("--vpc", default="", help="explicit VPC id (default: Dalston's, else the default VPC)")
    p_setup.set_defaults(func=cmd_setup)

    p_secrets = sub.add_parser("secrets", help="seed or inspect SSM Parameter Store")
    p_secrets.add_argument("action", choices=["put", "list"])
    p_secrets.add_argument("--from-env-file", default="", help="KEY=VALUE file to upload (put)")
    p_secrets.add_argument("--overwrite", action="store_true", help="replace parameters that already exist")
    p_secrets.set_defaults(func=cmd_secrets)

    p_launch = sub.add_parser("launch", help="launch the EC2 instance and bootstrap it")
    p_launch.add_argument("--instance-type", default=INSTANCE_TYPE)
    p_launch.add_argument("--volume-size", type=int, default=ROOT_VOLUME_SIZE)
    p_launch.add_argument("--image-tag", default=DEFAULT_IMAGE_TAG, help="GHCR tag (default prod-latest)")
    p_launch.add_argument(
        "--kit-ref",
        default="",
        help="git ref the deploy kit is fetched from (default: this checkout's commit)",
    )
    p_launch.set_defaults(func=cmd_launch)

    p_dns = sub.add_parser("dns", help="point the domain at the instance (Route53)")
    p_dns.add_argument("--no-wait", action="store_true", help="don't block until the change is INSYNC")
    p_dns.set_defaults(func=cmd_dns)

    p_reconcile = sub.add_parser(
        "reconcile", help="re-apply the bootstrap on the live instance (upgrades, config changes)"
    )
    p_reconcile.add_argument("--image-tag", default="", help="GHCR tag to move to (default: current)")
    p_reconcile.add_argument("--kit-ref", default="", help="deploy-kit git ref to move to (default: the pinned one)")
    p_reconcile.set_defaults(func=cmd_reconcile)

    p_status = sub.add_parser("status", help="instance, bootstrap, containers and readiness")
    p_status.set_defaults(func=cmd_status)

    p_logs = sub.add_parser("logs", help="tail container logs via SSM")
    p_logs.add_argument("--service", default="", help="compose service (default: all)")
    p_logs.add_argument("--lines", type=int, default=50)
    p_logs.set_defaults(func=cmd_logs)

    p_ssh = sub.add_parser("ssh", help="open a shell via SSM Session Manager")
    p_ssh.set_defaults(func=cmd_ssh)

    p_teardown = sub.add_parser("teardown", help="delete the instance, SG and IAM (keeps S3 + secrets)")
    p_teardown.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    p_teardown.set_defaults(func=cmd_teardown)

    return parser


def main() -> None:
    args = build_parser().parse_args()
    if args.command == "secrets" and args.action == "put" and not args.from_env_file:
        die("secrets put requires --from-env-file <path>")
    try:
        args.func(args)
    except KeyboardInterrupt:
        die("Interrupted.")
    except ClientError as exc:
        code = exc.response.get("Error", {}).get("Code", "")
        message = exc.response.get("Error", {}).get("Message", str(exc))
        if code in ("UnauthorizedOperation", "AccessDenied", "AccessDeniedException"):
            die(f"AWS denied the call ({code}): {message}\nCheck the credentials' permissions.")
        die(f"AWS error {code}: {message}")


if __name__ == "__main__":
    main()
