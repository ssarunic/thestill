# Cloud-init user-data
# ---------------------------------------------------------------------------


def build_user_data(region: str, bucket: str, image_tag: str, kit_ref: str = "main") -> str:
    """Compose the bootstrap script.

    Structure follows dalston: a fixed header, one f-string block holding
    every interpolated value, then a raw-string body so bash ${...} and
    {braces} can never collide with Python formatting.

    Every step is written to converge, not to assume a clean box, so the
    same script is both the cloud-init first boot AND what ``reconcile``
    re-runs over SSM against a live instance.
    """
    header = "#!/bin/bash\nset -euo pipefail\nexec > >(tee /var/log/user-data.log) 2>&1\n"

    # The ONLY interpolated block; shlex.quote keeps a hostile tag or bucket
    # name from breaking out of the assignment.
    variables = (
        "\n".join(
            [
                f"export AWS_DEFAULT_REGION={shlex.quote(region)}",
                f"export SSM_PREFIX={shlex.quote(SSM_PREFIX)}",
                f"BACKUP_BUCKET={shlex.quote(bucket)}",
                f"DEPLOY_KIT_BASE={shlex.quote(deploy_kit_base(kit_ref))}",
                f"IMAGE_TAG={shlex.quote(image_tag)}",
                f"REMOTE_DIR={shlex.quote(REMOTE_DIR)}",
                f"CONTAINER_UID={CONTAINER_UID}",
                f"BOOTSTRAP_MARKER={shlex.quote(BOOTSTRAP_MARKER)}",
                f"BACKUP_ONCALENDAR={shlex.quote(BACKUP_ONCALENDAR)}",
            ]
        )
        + "\n"
    )

    body = r"""
echo "=== thestill bootstrap starting ==="

dnf install -y docker jq
systemctl enable --now docker
usermod -aG docker ec2-user

# Compose v2 as a CLI plugin (AL2023 has no compose package).
install -d /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-aarch64" \
    -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

install -d -m 0755 "$REMOTE_DIR"
cd "$REMOTE_DIR"
for f in docker-compose.prod.yml Caddyfile fetch-secrets.sh backup.sh; do
    curl -fsSL "$DEPLOY_KIT_BASE/$f" -o "$f"
done
chmod +x fetch-secrets.sh backup.sh

# The container runs as a non-root uid; the bind mount must be writable by it.
install -d -o "$CONTAINER_UID" -g "$CONTAINER_UID" "$REMOTE_DIR/data"

./fetch-secrets.sh
# Delete-then-append so re-running this script can't accumulate duplicate
# assignments (fetch-secrets.sh rewrites .env, but never assume it ran).
sed -i "/^THESTILL_IMAGE_TAG=/d" .env
printf "THESTILL_IMAGE_TAG='%s'\n" "$IMAGE_TAG" >> .env
chmod 600 .env

docker compose -f docker-compose.prod.yml pull
docker compose -f docker-compose.prod.yml up -d

# Nightly backup as a systemd timer — AL2023 minimal ships no cron.
cat > /etc/systemd/system/thestill-backup.service <<EOF
[Unit]
Description=thestill nightly backup (pg_dump + artifact sync to S3)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=BACKUP_BUCKET=$BACKUP_BUCKET
Environment=AWS_DEFAULT_REGION=$AWS_DEFAULT_REGION
ExecStart=$REMOTE_DIR/backup.sh
EOF

cat > /etc/systemd/system/thestill-backup.timer <<EOF
[Unit]
Description=Run the thestill backup nightly

[Timer]
OnCalendar=$BACKUP_ONCALENDAR
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now thestill-backup.timer

install -d "$(dirname "$BOOTSTRAP_MARKER")"
date -u +%Y-%m-%dT%H:%M:%SZ > "$BOOTSTRAP_MARKER"
echo "=== thestill bootstrap complete ==="
"""
    return header + variables + body


# ---------------------------------------------------------------------------
# SSM Run Command (the only remote-exec path — no SSH keys anywhere)
# ---------------------------------------------------------------------------


# SSM caps inline output at 24,000 chars (stdout) / 8,000 (stderr) with no
# truncation flag, so a long reconcile can lose exactly the error you need.
SSM_INLINE_STDOUT_LIMIT = 24000


def run_remote(
    region: str,
    instance_id: str,
    command: str,
    *,
    timeout: int = 120,
    output_bucket: str = "",
) -> tuple[int, str]:
    """Run a shell command on the box via SSM. Returns (exit_code, output).

    Pass ``output_bucket`` for commands whose output can be long: SSM then
    also writes the full stream to S3 and we surface that URL instead of
    silently handing back a truncated tail.
    """
    ssm = client("ssm", region)
    send_kwargs: dict[str, Any] = {
        "InstanceIds": [instance_id],
        "DocumentName": "AWS-RunShellScript",
        "Parameters": {"commands": [command]},
    }
    if output_bucket:
        send_kwargs["OutputS3BucketName"] = output_bucket
        send_kwargs["OutputS3KeyPrefix"] = "ssm-command-output"
    try:
        cmd_id = ssm.send_command(**send_kwargs)["Command"]["CommandId"]
    except ClientError as exc:
        code = exc.response["Error"]["Code"]
        if code == "InvalidInstanceId":
            return 255, (
                "SSM agent not reachable yet (instance still booting, or the " "instance profile is not attached)."
            )
        raise

    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(3)
        try:
            result = ssm.get_command_invocation(CommandId=cmd_id, InstanceId=instance_id)
        except ClientError:
            continue
        if result["Status"] in ("Pending", "InProgress", "Delayed"):
            continue
        stdout = result.get("StandardOutputContent", "") or ""
        stderr = result.get("StandardErrorContent", "") or ""
        output = stdout + stderr
        if len(stdout) >= SSM_INLINE_STDOUT_LIMIT:
            url = result.get("StandardOutputUrl", "")
            output += f"\n\n[output truncated at {SSM_INLINE_STDOUT_LIMIT} chars by SSM" + (
                f" — full log: {url}]" if url else "; re-run with an output bucket for the full log]"
            )
        return int(result.get("ResponseCode", -1)), output.strip()
    return 254, f"Timed out after {timeout}s waiting for the command to finish"


