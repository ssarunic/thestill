def cmd_setup(args: argparse.Namespace) -> None:
    region = args.region
    domain = args.domain.strip().lower().rstrip(".")
    if not domain or "." not in domain:
        die(f"--domain must be a fully-qualified hostname (got {args.domain!r})")

    existing = load_state()
    if existing and existing.instance_id:
        log("Existing deployment found — verifying infrastructure")

    step("1/5  Identity")
    log(f"AWS account {account_id(region)}, region {region}")

    step("2/5  Networking")
    if args.dalston_sg:
        vpc_id = sg_vpc(region, args.dalston_sg)
        log(f"VPC derived from Dalston's security group: {vpc_id}")
    elif args.vpc:
        vpc_id = args.vpc
    else:
        vpc_id = default_vpc(region)
        warn(
            "Using the default VPC. Dalston must be in this VPC (or peered "
            "with it) for private transcription traffic — pass --dalston-sg "
            "to derive the VPC from Dalston instead."
        )
    sg_id = ensure_app_sg(region, vpc_id)
    subnet_id = pick_public_subnet(region, vpc_id)
    log(f"Subnet: {subnet_id}")
    if args.dalston_sg:
        ensure_dalston_rule(region, args.dalston_sg, sg_id, args.dalston_port)

    step("3/5  Storage")
    bucket = ensure_bucket(region)

    step("4/5  IAM")
    role_name, profile_name = ensure_iam(region, bucket)

    step("5/5  Derived secrets")
    # Values the operator should never have to hand-write: they follow from
    # --domain, and POSTGRES_PASSWORD must be URI-safe because the compose
    # file interpolates it into DATABASE_URL unescaped.
    derived = {
        "PUBLIC_DOMAIN": domain,
        "PUBLIC_BASE_URL": f"https://{domain}",
        "ALLOWED_ORIGINS": f"https://{domain}",
        "POSTGRES_PASSWORD": pysecrets.token_hex(32),
        "ENVIRONMENT": "production",
        "COOKIE_SECURE": "true",
        # Ship dark on the first boot: the operator flips these at cutover,
        # once the old machine's schedulers are stopped.
        "REFRESH_SCHEDULER_ENABLED": "false",
        "BRIEFING_SCHEDULER_ENABLED": "false",
    }
    for name, value in derived.items():
        if put_secret(region, name, value):
            log(f"  seeded {name}")
        else:
            log(f"  {name} already set (left untouched)")

    state = existing or Deployment()
    state.region = region
    state.domain = domain
    state.vpc_id = vpc_id
    state.subnet_id = subnet_id
    state.sg_id = sg_id
    state.dalston_sg = args.dalston_sg or ""
    state.dalston_port = args.dalston_port if args.dalston_sg else 0
    state.bucket = bucket
    state.role_name = role_name
    state.profile_name = profile_name
    state.created_at = state.created_at or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    save_state(state)
    audit("setup", region=region, domain=domain, vpc=vpc_id, sg=sg_id, bucket=bucket)

    print()
    log("Setup complete. No billable resources created yet.")
    print(
        "\nNext:\n"
        "  1. Add your API keys and Dalston settings:\n"
        "       thestill-aws secrets put --from-env-file prod-secrets.env\n"
        "     Needed: JWT_SECRET_KEY, an LLM key (e.g. GEMINI_API_KEY),\n"
        "     DALSTON_BASE_URL, DALSTON_API_KEY, URL_GUARD_ALLOWLIST,\n"
        "     GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET if MULTI_USER=true.\n"
        f"  2. Add https://{domain}/api/auth/callback to the Google OAuth console.\n"
        "  3. thestill-aws launch\n"
    )


def cmd_secrets(args: argparse.Namespace) -> None:
    state = require_state()
    region = state.region

    if args.action == "list":
        present = list_secrets(region)
        if not present:
            log(f"No parameters under {SSM_PREFIX}")
            return
        log(f"{len(present)} parameters under {SSM_PREFIX}:")
        for name in sorted(present):
            # Names only. Values are secrets and this output gets pasted.
            print(f"  {name}")
        return

    path = Path(args.from_env_file).expanduser()
    if not path.is_file():
        die(f"No such file: {path}")
    values = parse_env_file(path)
    if not values:
        die(f"{path} contained no KEY=VALUE lines")

    written, skipped = [], []
    for name, value in sorted(values.items()):
        if put_secret(region, name, value, overwrite=args.overwrite):
            written.append(name)
        else:
            skipped.append(name)

    for name in written:
        log(f"  wrote {name}")
    for name in skipped:
        warn(f"  {name} already exists — re-run with --overwrite to replace it")
    audit("secrets_put", written=written, skipped=skipped)
    log(f"{len(written)} written, {len(skipped)} left untouched")


def cmd_launch(args: argparse.Namespace) -> None:
    state = require_state()
    region = state.region

    # Idempotent: converge on "one running app instance" rather than failing.
    existing = discover_instance(region)
    if existing:
        current = existing["State"]["Name"]
        instance_id = existing["InstanceId"]
        if current in ("running", "pending"):
            log(f"App instance {instance_id} is already {current} — nothing to do.")
            print("  Inspect it with: thestill-aws status")
            print("  Re-apply the on-box config with: thestill-aws reconcile")
            return
        if current in ("stopped", "stopping"):
            log(f"App instance {instance_id} is {current} — starting it instead of launching a new one.")
            client("ec2", region).start_instances(InstanceIds=[instance_id])
            client("ec2", region).get_waiter("instance_running").wait(InstanceIds=[instance_id])
            audit("started", instance=instance_id)
            log(f"{instance_id} is running")
            return

    step("1/4  Preflight")
    preflight_secrets(region)

    step("2/4  Resolving AMI")
    ami_id, root_device = resolve_ami(region)
    log(f"AL2023 arm64: {ami_id} (root device {root_device})")

    step("3/4  Launching instance")
    kit_ref = args.kit_ref or default_kit_ref()
    log(f"Deploy kit pinned to {kit_ref[:12] if len(kit_ref) > 12 else kit_ref}")
    user_data = build_user_data(region, state.bucket, args.image_tag, kit_ref)
    ec2 = client("ec2", region)
    instance = retry_aws(
        ec2.run_instances,
        ImageId=ami_id,
        InstanceType=args.instance_type,
        MinCount=1,
        MaxCount=1,
        IamInstanceProfile={"Name": state.profile_name},
        UserData=user_data,
        NetworkInterfaces=[
            {
                "DeviceIndex": 0,
                "SubnetId": state.subnet_id,
                "Groups": [state.sg_id],
                "AssociatePublicIpAddress": True,
                "DeleteOnTermination": True,
            }
        ],
        BlockDeviceMappings=[
            {
                "DeviceName": root_device,
                "Ebs": {
                    "VolumeSize": args.volume_size,
                    "VolumeType": "gp3",
                    "Encrypted": True,
                    "DeleteOnTermination": True,
                },
            }
        ],
        MetadataOptions={
            # IMDSv2 only: a container escape or SSRF must not be able to
            # read instance-role credentials without a session token.
            "HttpTokens": "required",
            "HttpPutResponseHopLimit": 2,
            "HttpEndpoint": "enabled",
        },
        # Tags go in the launch call, never as a follow-up CreateTags: a
        # failure there would leave the instance invisible to discovery.
        TagSpecifications=[
            {"ResourceType": "instance", "Tags": base_tags("app")},
            {"ResourceType": "volume", "Tags": base_tags("app")},
        ],
    )["Instances"][0]

    instance_id = instance["InstanceId"]
    state.instance_id = instance_id
    state.image_tag = args.image_tag
    state.kit_ref = kit_ref
    save_state(state)
    audit("launched", instance=instance_id, ami=ami_id, type=args.instance_type)
    log(f"Launched {instance_id}")

    log("Waiting for the instance to reach 'running'...")
    ec2.get_waiter("instance_running").wait(InstanceIds=[instance_id])
    ip = describe_instance(region, instance_id).get("PublicIpAddress", "")
    log(f"Running at {ip}")

    step("4/4  Auto-recovery alarm")
    _ensure_recovery_alarm(region, instance_id)

    print()
    log("Instance is up; cloud-init is still bootstrapping (3-6 minutes).")
    print(
        "\nNext:\n"
        "  thestill-aws status          # watch the bootstrap finish\n"
        "  thestill-aws dns             # point the domain at this instance\n"
        "  thestill-aws logs            # container logs once bootstrap completes\n"
    )


def _ensure_recovery_alarm(region: str, instance_id: str) -> None:
    """Free CloudWatch alarm that recovers the instance on host failure."""
    cw = client("cloudwatch", region)
    name = f"{NAME_PREFIX}-{instance_id}-auto-recovery"
    cw.put_metric_alarm(
        AlarmName=name,
        AlarmDescription="Recover thestill on failed EC2 system status checks",
        Namespace="AWS/EC2",
        MetricName="StatusCheckFailed_System",
        Statistic="Maximum",
        Dimensions=[{"Name": "InstanceId", "Value": instance_id}],
        Period=60,
        EvaluationPeriods=2,
        Threshold=1.0,
        ComparisonOperator="GreaterThanOrEqualToThreshold",
        AlarmActions=[f"arn:aws:automate:{region}:ec2:recover"],
    )
    log(f"Auto-recovery alarm set: {name}")


def cmd_dns(args: argparse.Namespace) -> None:
    state = require_state()
    inst = discover_instance(state.region)
    if not inst:
        die("No running instance found. Run 'thestill-aws launch' first.")
    ip = inst.get("PublicIpAddress", "")
    if not ip:
        die(f"Instance {inst['InstanceId']} has no public IP yet — retry shortly.")
    upsert_a_record(state.domain, ip, wait=not args.no_wait)
    print()
    log(f"https://{state.domain} will serve once Caddy obtains its certificate.")
    print("  Watch it: thestill-aws logs --service caddy")


def cmd_reconcile(args: argparse.Namespace) -> None:
    """Re-run the bootstrap on the live instance.

    The same script cloud-init ran at first boot, replayed over SSM. Use it
    to pick up a new image tag, changed SSM secrets, or an updated deploy
    kit without relaunching the instance."""
    state = require_state()
    region = state.region
    inst = discover_instance(region)
    if not inst:
        die("No running instance found. Run 'thestill-aws launch' first.")
    if inst["State"]["Name"] != "running":
        die(f"Instance {inst['InstanceId']} is {inst['State']['Name']}, not running.")

    image_tag = args.image_tag or state.image_tag
    # Reuse the pinned kit unless explicitly moved: replaying `main` onto a
    # box running an older image is how version skew gets introduced.
    kit_ref = args.kit_ref or state.kit_ref or "main"
    log(f"Re-applying bootstrap on {inst['InstanceId']} (image {image_tag}, kit {kit_ref[:12]})")
    log("This pulls the image and recreates changed containers; expect 1-3 minutes.")

    code, out = run_remote(
        region,
        inst["InstanceId"],
        build_user_data(region, state.bucket, image_tag, kit_ref),
        timeout=600,
        output_bucket=state.bucket,
    )
    print(_indent(out))
    if code != 0:
        die(f"Reconcile failed with exit code {code} (see output above).")

    state.image_tag = image_tag
    state.kit_ref = kit_ref
    save_state(state)
    audit("reconciled", instance=inst["InstanceId"], image_tag=image_tag)
    log("Reconcile complete. Check 'thestill-aws status'.")


def cmd_status(args: argparse.Namespace) -> None:
    state = require_state()
    region = state.region

    inst = discover_instance(region)
    if not inst:
        log("No app instance is running.")
        print(f"  Region:  {region}\n  Domain:  {state.domain}\n  Bucket:  {state.bucket}")
        print("\n  Launch one with: thestill-aws launch")
        return

    instance_id = inst["InstanceId"]
    ip = inst.get("PublicIpAddress", "-")
    print(f"  Instance:  {instance_id} ({inst['State']['Name']}, {inst['InstanceType']})")
    print(f"  Public IP: {ip}")
    print(f"  Domain:    {state.domain}")
    print(f"  Image tag: {state.image_tag}")
    print(f"  Bucket:    {state.bucket}")

    if inst["State"]["Name"] != "running":
        return

    code, out = run_remote(
        region,
        instance_id,
        f"test -f {BOOTSTRAP_MARKER} && echo COMPLETE || (echo PENDING; tail -n 3 /var/log/user-data.log 2>/dev/null)",
    )
    if code == 255:
        print(f"  Bootstrap: unknown — {out}")
        return
    if out.startswith("COMPLETE"):
        print("  Bootstrap: complete")
    else:
        print(f"  Bootstrap: in progress\n{_indent(out)}")
        return

    code, out = run_remote(
        region,
        instance_id,
        f"cd {REMOTE_DIR} && docker compose -f docker-compose.prod.yml ps --format "
        "'{{.Service}} {{.State}} {{.Status}}'",
    )
    print(f"  Containers:\n{_indent(out)}")

    code, out = run_remote(
        region,
        instance_id,
        "curl -fsS -o /dev/null -w '%{http_code}' http://localhost:8000/health/ready || true",
    )
    verdict = "ready (200)" if out.strip().endswith("200") else f"NOT ready (got {out.strip() or 'no response'})"
    print(f"  Readiness: {verdict}")


def _indent(text: str, prefix: str = "    ") -> str:
    return "\n".join(prefix + line for line in (text or "").splitlines())


def cmd_logs(args: argparse.Namespace) -> None:
    state = require_state()
    inst = discover_instance(state.region)
    if not inst:
        die("No running instance found.")
    code, out = run_remote(
        state.region,
        inst["InstanceId"],
        f"cd {REMOTE_DIR} && docker compose -f docker-compose.prod.yml logs " f"--tail {args.lines} {args.service}",
        timeout=90,
    )
    print(out)
    if code not in (0, -1):
        warn(f"remote exit code {code}")


def cmd_ssh(args: argparse.Namespace) -> None:
    state = require_state()
    inst = discover_instance(state.region)
    if not inst:
        die("No running instance found.")
    instance_id = inst["InstanceId"]
    log(f"Opening an SSM session to {instance_id} (no SSH key, no port 22)...")
    try:
        subprocess.run(
            ["aws", "ssm", "start-session", "--target", instance_id, "--region", state.region],
            check=False,
        )
    except FileNotFoundError:
        die(
            "The AWS CLI is required for SSM sessions.\n"
            "  brew install awscli\n"
            "  (and the Session Manager plugin: "
            "https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager-working-with-install-plugin.html)"
        )


def cmd_teardown(args: argparse.Namespace) -> None:
    state = require_state()
    region = state.region
    inst = discover_instance(region)

    print("This will delete:")
    if inst:
        print(f"  - EC2 instance {inst['InstanceId']} (and its encrypted root volume)")
        print(f"  - CloudWatch alarm {NAME_PREFIX}-{inst['InstanceId']}-auto-recovery")
    print(f"  - Security group {state.sg_id}")
    if state.dalston_sg:
        print(f"  - The ingress rule allowing {state.sg_id} -> {state.dalston_sg}:{state.dalston_port}")
    print(f"  - IAM role {state.role_name} + instance profile {state.profile_name}")
    print("\nNOT deleted (deliberately):")
    print(f"  - S3 bucket {state.bucket} (your backups)")
    print(f"  - SSM parameters under {SSM_PREFIX} (your secrets)")
    print(f"  - The Route53 A record for {state.domain}")

    if not args.yes:
        if input("\nType 'yes' to confirm: ").strip() != "yes":
            die("Aborted.")

    ec2 = client("ec2", region)

    if inst:
        instance_id = inst["InstanceId"]
        log(f"Terminating {instance_id}...")
        ec2.terminate_instances(InstanceIds=[instance_id])
        try:
            ec2.get_waiter("instance_terminated").wait(InstanceIds=[instance_id])
        except WaiterError:
            warn("Timed out waiting for termination; continuing.")
        try:
            client("cloudwatch", region).delete_alarms(AlarmNames=[f"{NAME_PREFIX}-{instance_id}-auto-recovery"])
        except ClientError as exc:
            warn(f"Could not delete the alarm: {exc}")
        audit("terminated", instance=instance_id)

    # Dalston's rule references our SG, so it must go before the SG itself.
    if state.dalston_sg and state.sg_id:
        try:
            ec2.revoke_security_group_ingress(
                GroupId=state.dalston_sg,
                IpPermissions=[
                    {
                        "IpProtocol": "tcp",
                        "FromPort": state.dalston_port,
                        "ToPort": state.dalston_port,
                        "UserIdGroupPairs": [{"GroupId": state.sg_id}],
                    }
                ],
            )
            log("Revoked the Dalston ingress rule")
        except ClientError as exc:
            warn(f"Could not revoke the Dalston rule: {exc}")

    if state.sg_id:
        for attempt in range(6):
            try:
                ec2.delete_security_group(GroupId=state.sg_id)
                log(f"Deleted security group {state.sg_id}")
                break
            except ClientError as exc:
                # The ENI can linger for a few seconds after termination.
                if attempt == 5:
                    warn(f"Could not delete {state.sg_id}: {exc}")
                    break
                time.sleep(10)

    iam = client("iam")
    if state.profile_name:
        try:
            iam.remove_role_from_instance_profile(InstanceProfileName=state.profile_name, RoleName=state.role_name)
        except ClientError:
            pass
        try:
            iam.delete_instance_profile(InstanceProfileName=state.profile_name)
            log(f"Deleted instance profile {state.profile_name}")
        except ClientError as exc:
            warn(f"Could not delete the instance profile: {exc}")

    if state.role_name:
        for policy in (f"{NAME_PREFIX}-s3-backups", f"{NAME_PREFIX}-ssm-secrets"):
            try:
                iam.delete_role_policy(RoleName=state.role_name, PolicyName=policy)
            except ClientError:
                pass
        try:
            iam.detach_role_policy(
                RoleName=state.role_name,
                PolicyArn="arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
            )
        except ClientError:
            pass
        try:
            iam.delete_role(RoleName=state.role_name)
            log(f"Deleted IAM role {state.role_name}")
        except ClientError as exc:
            warn(f"Could not delete the role: {exc}")

    state.instance_id = ""
    state.sg_id = ""
    state.role_name = ""
    state.profile_name = ""
    save_state(state)
    audit("teardown", region=region)

    print()
    log("Teardown complete.")
    print(
        f"\nStill present, remove by hand if you really mean it:\n"
        f"  aws s3 rb s3://{state.bucket} --force\n"
        f"  aws ssm delete-parameters --names $(aws ssm get-parameters-by-path "
        f"--path {SSM_PREFIX} --query 'Parameters[].Name' --output text)\n"
    )


