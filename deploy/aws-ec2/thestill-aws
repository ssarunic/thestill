_clients: dict[str, Any] = {}


def client(service: str, region: str = "") -> Any:
    key = f"{service}:{region}"
    if key not in _clients:
        _clients[key] = boto3.client(service, region_name=region or None)
    return _clients[key]


_account_id: Optional[str] = None


def account_id(region: str) -> str:
    global _account_id
    if _account_id is None:
        _account_id = client("sts", region).get_caller_identity()["Account"]
    return _account_id


_NON_RETRYABLE = frozenset({"InstanceLimitExceeded", "VcpuLimitExceeded", "UnauthorizedOperation"})


def retry_aws(func, *args, max_retries: int = 4, **kwargs):
    """Retry transient AWS errors; fail fast on quota/permission errors."""
    delay = 2
    for attempt in range(1, max_retries + 1):
        try:
            return func(*args, **kwargs)
        except ClientError as exc:
            code = exc.response.get("Error", {}).get("Code", "")
            if code in _NON_RETRYABLE or attempt >= max_retries:
                raise
            warn(f"Attempt {attempt} failed ({code}), retrying in {delay}s...")
            time.sleep(delay)
            delay *= 2


def base_tags(role: str) -> list[dict]:
    return [
        {"Key": "Name", "Value": f"{NAME_PREFIX}-{role}"},
        {"Key": "Project", "Value": NAME_PREFIX},
        {"Key": f"{NAME_PREFIX}:role", "Value": role},
        {"Key": f"{NAME_PREFIX}:managed-by", "Value": "thestill-aws"},
    ]


# ---------------------------------------------------------------------------
# EC2 lookups
# ---------------------------------------------------------------------------


def describe_instance(region: str, instance_id: str) -> Optional[dict]:
    """Describe one instance. Returns None ONLY when AWS confirms it is gone —
    every other error propagates, because callers use the result to decide
    whether to skip a terminate call."""
    try:
        resp = client("ec2", region).describe_instances(InstanceIds=[instance_id])
    except ClientError as exc:
        if exc.response["Error"]["Code"] == "InvalidInstanceID.NotFound":
            return None
        raise
    try:
        return resp["Reservations"][0]["Instances"][0]
    except (IndexError, KeyError):
        return None


def instance_state(region: str, instance_id: str) -> str:
    inst = describe_instance(region, instance_id)
    return inst["State"]["Name"] if inst else "terminated"


def discover_instance(region: str) -> Optional[dict]:
    """Find the app instance by tag — EC2 is the source of truth, not the
    local state file (which a second laptop would not have)."""
    resp = client("ec2", region).describe_instances(
        Filters=[
            {"Name": f"tag:{NAME_PREFIX}:role", "Values": ["app"]},
            {"Name": "instance-state-name", "Values": ["pending", "running", "stopping", "stopped"]},
        ]
    )
    for reservation in resp.get("Reservations", []):
        for inst in reservation.get("Instances", []):
            return inst
    return None


def resolve_ami(region: str) -> tuple[str, str]:
    """Return (ami_id, root_device_name) for the latest AL2023 arm64 image.

    The root device name comes from the AMI itself. dalston hard-coded
    /dev/xvda against an image whose root was /dev/sda1, which silently
    produced an unencrypted root volume plus an idle encrypted one (M93).
    """
    ami_id = client("ssm", region).get_parameter(Name=AL2023_ARM64_SSM)["Parameter"]["Value"]
    images = client("ec2", region).describe_images(ImageIds=[ami_id])["Images"]
    if not images:
        die(f"AMI {ami_id} resolved from SSM but describe_images returned nothing")
    return ami_id, images[0].get("RootDeviceName", "/dev/xvda")


