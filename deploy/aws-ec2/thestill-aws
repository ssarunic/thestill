# Route53
# ---------------------------------------------------------------------------


def find_hosted_zone(domain: str) -> tuple[str, str]:
    """Return (zone_id, zone_name) for the most specific zone covering
    ``domain``. Raises via die() when nothing matches."""
    r53 = client("route53")
    candidates: list[tuple[str, str]] = []
    paginator = r53.get_paginator("list_hosted_zones")
    for page in paginator.paginate():
        for zone in page["HostedZones"]:
            if zone.get("Config", {}).get("PrivateZone"):
                continue
            name = zone["Name"].rstrip(".")
            if domain == name or domain.endswith("." + name):
                candidates.append((zone["Id"].split("/")[-1], name))
    if not candidates:
        die(
            f"No public Route53 hosted zone covers {domain}.\n"
            "Create the A record manually at your DNS provider instead, then "
            "run 'thestill-aws status'."
        )
    # Most specific zone wins (sub.example.com beats example.com).
    return sorted(candidates, key=lambda z: len(z[1]), reverse=True)[0]


def current_a_record(zone_id: str, domain: str) -> list[str]:
    resp = client("route53").list_resource_record_sets(
        HostedZoneId=zone_id, StartRecordName=domain, StartRecordType="A", MaxItems="1"
    )
    for record in resp.get("ResourceRecordSets", []):
        if record["Name"].rstrip(".") == domain and record["Type"] == "A":
            return [r["Value"] for r in record.get("ResourceRecords", [])]
    return []


def upsert_a_record(domain: str, ip: str, *, wait: bool = True) -> None:
    zone_id, zone_name = find_hosted_zone(domain)
    if current_a_record(zone_id, domain) == [ip]:
        log(f"A record {domain} already points at {ip} — nothing to change.")
        return
    log(f"Upserting A record {domain} -> {ip} in zone {zone_name} ({zone_id})")
    r53 = client("route53")
    change = r53.change_resource_record_sets(
        HostedZoneId=zone_id,
        ChangeBatch={
            "Comment": "thestill-aws",
            "Changes": [
                {
                    "Action": "UPSERT",
                    "ResourceRecordSet": {
                        "Name": domain,
                        "Type": "A",
                        "TTL": 60,
                        "ResourceRecords": [{"Value": ip}],
                    },
                }
            ],
        },
    )["ChangeInfo"]
    audit("dns_upserted", domain=domain, ip=ip, zone=zone_id)
    if not wait:
        return
    log("Waiting for the change to propagate (INSYNC)...")
    try:
        r53.get_waiter("resource_record_sets_changed").wait(
            Id=change["Id"], WaiterConfig={"Delay": 10, "MaxAttempts": 30}
        )
        log("DNS is live")
    except WaiterError:
        warn("Still PENDING after 5 minutes — it will settle on its own.")


