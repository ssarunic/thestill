def ensure_bucket(region: str) -> str:
    bucket = f"{NAME_PREFIX}-backups-{account_id(region)}"
    s3 = client("s3", region)
    try:
        s3.head_bucket(Bucket=bucket)
        log(f"S3 bucket {bucket} already exists")
        return bucket
    except ClientError:
        pass

    log(f"Creating S3 bucket: {bucket}")
    kwargs: dict[str, Any] = {"Bucket": bucket}
    if region != "us-east-1":
        kwargs["CreateBucketConfiguration"] = {"LocationConstraint": region}
    s3.create_bucket(**kwargs)

    s3.put_public_access_block(
        Bucket=bucket,
        PublicAccessBlockConfiguration={
            "BlockPublicAcls": True,
            "IgnorePublicAcls": True,
            "BlockPublicPolicy": True,
            "RestrictPublicBuckets": True,
        },
    )
    s3.put_bucket_encryption(
        Bucket=bucket,
        ServerSideEncryptionConfiguration={
            "Rules": [{"ApplyServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]
        },
    )
    # Versioning is the fat-finger/ransomware guard for the only copy of the
    # database; the lifecycle rule keeps 30 days of noncurrent versions.
    s3.put_bucket_versioning(Bucket=bucket, VersioningConfiguration={"Status": "Enabled"})
    s3.put_bucket_lifecycle_configuration(
        Bucket=bucket,
        LifecycleConfiguration={
            "Rules": [
                {
                    "ID": "expire-noncurrent",
                    "Status": "Enabled",
                    "Filter": {"Prefix": ""},
                    "NoncurrentVersionExpiration": {"NoncurrentDays": 30},
                    "AbortIncompleteMultipartUpload": {"DaysAfterInitiation": 7},
                }
            ]
        },
    )
    log("S3 bucket created (private, encrypted, versioned, 30-day noncurrent expiry)")
    audit("bucket_created", bucket=bucket, region=region)
    return bucket


# ---------------------------------------------------------------------------
# IAM
# ---------------------------------------------------------------------------


def ensure_iam(region: str, bucket: str) -> tuple[str, str]:
    iam = client("iam")
    role_name = f"{NAME_PREFIX}-app-role"
    profile_name = f"{NAME_PREFIX}-app-profile"

    try:
        iam.get_role(RoleName=role_name)
        log(f"IAM role {role_name} already exists")
    except ClientError:
        log(f"Creating IAM role: {role_name}")
        iam.create_role(
            RoleName=role_name,
            AssumeRolePolicyDocument=json.dumps(
                {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {"Service": "ec2.amazonaws.com"},
                            "Action": "sts:AssumeRole",
                        }
                    ],
                }
            ),
            Tags=[{"Key": "Project", "Value": NAME_PREFIX}],
        )
        audit("iam_role_created", role=role_name)

    # Backups need write; nothing on the box has any reason to delete an
    # object, so DeleteObject is deliberately absent (M93 lesson: a
    # compromised box should not be able to wipe the only backup).
    bucket_arn = f"arn:aws:s3:::{bucket}"
    iam.put_role_policy(
        RoleName=role_name,
        PolicyName=f"{NAME_PREFIX}-s3-backups",
        PolicyDocument=json.dumps(
            {
                "Version": "2012-10-17",
                "Statement": [
                    {"Effect": "Allow", "Action": ["s3:ListBucket"], "Resource": bucket_arn},
                    {
                        "Effect": "Allow",
                        "Action": ["s3:GetObject", "s3:PutObject"],
                        "Resource": f"{bucket_arn}/*",
                    },
                ],
            }
        ),
    )
    iam.put_role_policy(
        RoleName=role_name,
        PolicyName=f"{NAME_PREFIX}-ssm-secrets",
        PolicyDocument=json.dumps(
            {
                "Version": "2012-10-17",
                "Statement": [
                    {
                        "Effect": "Allow",
                        "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
                        "Resource": f"arn:aws:ssm:{region}:{account_id(region)}:parameter{SSM_PREFIX}*",
                    },
                    {
                        "Effect": "Allow",
                        "Action": ["kms:Decrypt"],
                        "Resource": "*",
                        "Condition": {"StringEquals": {"kms:ViaService": f"ssm.{region}.amazonaws.com"}},
                    },
                ],
            }
        ),
    )
    iam.attach_role_policy(
        RoleName=role_name,
        PolicyArn="arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
    )

    try:
        profile = iam.get_instance_profile(InstanceProfileName=profile_name)["InstanceProfile"]
        log(f"Instance profile {profile_name} already exists")
        # A previous run could have died between create_instance_profile and
        # add_role_to_instance_profile, leaving an empty profile that launches
        # an instance with no credentials at all. Converge instead of assuming.
        if not any(r["RoleName"] == role_name for r in profile.get("Roles", [])):
            warn(f"Instance profile {profile_name} has no role attached — attaching {role_name}")
            iam.add_role_to_instance_profile(InstanceProfileName=profile_name, RoleName=role_name)
            time.sleep(10)
    except ClientError:
        log(f"Creating instance profile: {profile_name}")
        iam.create_instance_profile(
            InstanceProfileName=profile_name,
            Tags=[{"Key": "Project", "Value": NAME_PREFIX}],
        )
        iam.add_role_to_instance_profile(InstanceProfileName=profile_name, RoleName=role_name)
        log("Waiting 10s for the instance profile to propagate...")
        time.sleep(10)

    log("IAM role + instance profile ready")
    return role_name, profile_name


