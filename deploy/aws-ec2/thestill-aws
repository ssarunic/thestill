def deploy_kit_base(ref: str) -> str:
    return f"https://raw.githubusercontent.com/{GITHUB_REPO}/{ref}/{DEPLOY_KIT_PATH}"


def default_kit_ref() -> str:
    """Pin the deploy kit to this checkout's commit when it is public.

    Fetching from ``main`` would mean a ``reconcile`` months from now
    silently pulls a compose file newer than the image tag the box is
    running — version skew that appears as a mystery boot failure. A commit
    SHA makes both launch and reconcile reproducible. Falls back to ``main``
    only when the SHA is not on the remote (nothing to fetch otherwise).
    """
    repo = Path(__file__).resolve().parents[2]
    try:
        sha = subprocess.run(
            ["git", "-C", str(repo), "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        remote = subprocess.run(
            ["git", "-C", str(repo), "branch", "-r", "--contains", sha],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError, OSError):
        warn("Not a git checkout — pinning the deploy kit to 'main'.")
        return "main"
    if "origin/main" not in remote:
        warn(
            f"HEAD ({sha[:8]}) is not on origin/main, so the instance could not "
            "fetch it — pinning the deploy kit to 'main'. Push first, or pass "
            "--kit-ref <sha>, for a reproducible bootstrap."
        )
        return "main"
    return sha


